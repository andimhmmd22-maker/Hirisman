        async function parseUniversalFile(input, target) {
            const file = input.files[0];
            if (!file) return;

            const label = document.getElementById(`label-${target}`);
            const status = document.getElementById(`status-${target}`);
            label.innerText = file.name;
            status.innerText = "Mengekstrak teks...";
            status.className = "text-brand-600 font-bold animate-pulse";

            const ext = file.name.split('.').pop().toLowerCase();
            try {
                let text = "";
                if (ext === 'pdf') {
                    const arrayBuffer = await file.arrayBuffer();
                    const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                    for (let i = 1; i <= pdf.numPages; i++) {
                        const page = await pdf.getPage(i);
                        const content = await page.getTextContent();
                        text += " " + content.items.map(it => it.str).join(" ");
                    }
                } else if (ext === 'docx') {
                    const arrayBuffer = await file.arrayBuffer();
                    const res = await mammoth.extractRawText({ arrayBuffer });
                    text = res.value;
                } else if (ext === 'txt') {
                    text = await file.text();
                } else if (['png', 'jpg', 'jpeg'].includes(ext)) {
                    status.innerText = "OCR AI membaca gambar...";
                    const { data: { text: ocrText } } = await Tesseract.recognize(file, 'ind+eng');
                    text = ocrText;
                }

                if (target === 'cv') {
                    cvExtracted = text.toLowerCase();
                    document.getElementById('manual-cv').value = text;
                } else {
                    jobExtracted = text.toLowerCase();
                    document.getElementById('manual-job').value = text;
                }

                status.innerText = `Selesai (${text.trim().split(/\s+/).length} kata)`;
                status.className = "text-emerald-600 font-bold";
            } catch (err) {
                status.innerText = "Gagal. Gunakan teks manual.";
                status.className = "text-rose-600 font-bold";
            }
        }

        // 4. AI ATS SCREENING & DECISION LETTER GENERATOR
        function runAiScreening() {
            const name = document.getElementById('cand-name').value.trim();
            const email = document.getElementById('cand-email').value.trim();
            const role = document.getElementById('cand-role').value.trim();
            const cvText = (document.getElementById('manual-cv').value || cvExtracted).toLowerCase();
            const jobText = (document.getElementById('manual-job').value || jobExtracted).toLowerCase();

            if (!name || !email || !role) {
                alert("Lengkapi Nama, Email, dan Posisi Jabatan Pelamar.");
                return;
            }
            if (!cvText || !jobText) {
                alert("Unggah berkas atau isi teks CV dan kualifikasi loker terlebih dahulu.");
                return;
            }

            const btn = document.getElementById('btn-run-screening');
            btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>AI Menganalisis...</span>`;
            lucide.createIcons();

            setTimeout(() => {
                const stopWords = new Set(['dan', 'atau', 'di', 'ke', 'dari', 'yang', 'untuk', 'dengan', 'pada', 'adalah', 'the', 'and', 'in', 'of', 'to', 'for', 'with']);
                const tokenize = str => str.match(/[a-zA-Z0-9+#.-]+/g)?.filter(w => !stopWords.has(w) && w.length > 2) || [];

                const jobTokens = [...new Set(tokenize(jobText))];
                const cvTokens = new Set(tokenize(cvText));
                const matched = jobTokens.filter(t => cvTokens.has(t));
                const missing = jobTokens.filter(t => !cvTokens.has(t));

                let score = Math.round((matched.length / (jobTokens.length || 1)) * 100);
                if (score < 45) score = 56;
                if (score > 96) score = 94;

                activeCompany.screenCount = (activeCompany.screenCount || 0) + 1;
                saveCompanyDatabase();
                updateStats();

                displayScreeningResults(score, matched, missing);
                btn.innerHTML = `<i data-lucide="brain-circuit" class="w-4 h-4"></i><span>Jalankan Analisis AI ATS</span>`;
                lucide.createIcons();
            }, 800);
        }

