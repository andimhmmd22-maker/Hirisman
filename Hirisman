    <!-- ENGINE JAVASCRIPT: CLOUD SYNC & REAL-TIME REPLICATION -->
    <script>
        const HIRISMAN_CONFIG = {
            version: "2.5.0",
            cloudSyncUrl: "https://kvdb.io/MNhT458y28PqyqfWvhG8k9/"
        };

        let activeAdmin = null;
        let activeCompany = null;
        let allCompanies = [];

        let cvExtracted = "";
        let jobExtracted = "";
        let currentFilter = 'all';
        let currentLang = 'id';
        let scannedRawEmployees = [];

        document.addEventListener('DOMContentLoaded', () => {
            initSystem();
            startLiveClock();
            checkAppUpdates(false);
            lucide.createIcons();
        });

        // 1. MASTER ACCOUNT & BIDIRECTIONAL CLOUD SYNC
        async function initSystem() {
            if (!localStorage.getItem('hirisman_users')) {
                localStorage.setItem('hirisman_users', JSON.stringify([
                    { name: "HR Administrator", email: "admin@hirisman.id", pwd: "admin123", isGoogle: false }
                ]));
            }
            if (!localStorage.getItem('hirisman_active_session')) {
                localStorage.setItem('hirisman_active_session', JSON.stringify({
                    name: "HR Administrator",
                    email: "admin@hirisman.id"
                }));
            }

            activeAdmin = JSON.parse(localStorage.getItem('hirisman_active_session'));
            await loadCompanyDatabaseWithCloudSync();
            updateUIHead();

            // Background Auto-Polling (Setiap 12 Detik Menyelaraskan Otomatis HP & PC)
            setInterval(async () => {
                if (activeAdmin && !document.hidden) {
                    try {
                        const cloudKey = btoa(activeAdmin.email.toLowerCase()).replace(/=/g, '');
                        const res = await fetch(HIRISMAN_CONFIG.cloudSyncUrl + cloudKey, { method: 'GET' });
                        if (res.ok) {
                            const cloudData = await res.json();
                            if (cloudData && Array.isArray(cloudData) && cloudData.length > 0) {
                                if (JSON.stringify(cloudData) !== JSON.stringify(allCompanies)) {
                                    allCompanies = cloudData;
                                    localStorage.setItem('hirisman_comp_db_' + activeAdmin.email.toLowerCase(), JSON.stringify(allCompanies));
                                    const lastId = localStorage.getItem('hirisman_last_cid_' + activeAdmin.email.toLowerCase());
                                    activeCompany = allCompanies.find(c => c.id === lastId) || allCompanies[0];
                                    renderActiveCompanyModules();
                                    document.getElementById('cloud-sync-tag').innerText = "Tersinkron Real-time";
                                }
                            }
                        }
                    } catch(e) {
                        // Jalur offline tetap aktif
                    }
                }
            }, 12000);
        }

        async function loadCompanyDatabaseWithCloudSync() {
            const localKey = 'hirisman_comp_db_' + activeAdmin.email.toLowerCase();
            const savedLocal = localStorage.getItem(localKey);

            if (savedLocal && JSON.parse(savedLocal).length > 0) {
                allCompanies = JSON.parse(savedLocal);
            } else {
                allCompanies = [{
                    id: 'comp_' + Date.now(),
                    name: "PT Solusi Utama Nusantara",
                    code: "SUN",
                    isPrivate: true,
                    bank: { name: "BCA", accNumber: "8830-1928-3100", holder: "PT Solusi Utama Nusantara", balance: 250000000 },
                    employees: [],
                    attendance: [],
                    screenCount: 0
                }];
            }

            // Sync dari Cloud
            try {
                const cloudKey = btoa(activeAdmin.email.toLowerCase()).replace(/=/g, '');
                const response = await fetch(HIRISMAN_CONFIG.cloudSyncUrl + cloudKey, { method: 'GET' });
                if (response.ok) {
                    const cloudData = await response.json();
                    if (cloudData && Array.isArray(cloudData) && cloudData.length > 0) {
                        allCompanies = cloudData;
                        localStorage.setItem(localKey, JSON.stringify(allCompanies));
                    }
                }
            } catch(err) {
                console.log("Cloud offline fallback active.");
            }

            const lastId = localStorage.getItem('hirisman_last_cid_' + activeAdmin.email.toLowerCase());
            activeCompany = allCompanies.find(c => c.id === lastId) || allCompanies[0];
            renderActiveCompanyModules();
        }

        async function saveCompanyDatabase() {
            const localKey = 'hirisman_comp_db_' + activeAdmin.email.toLowerCase();
            localStorage.setItem(localKey, JSON.stringify(allCompanies));
            if (activeCompany) {
                localStorage.setItem('hirisman_last_cid_' + activeAdmin.email.toLowerCase(), activeCompany.id);
            }

            try {
                const cloudKey = btoa(activeAdmin.email.toLowerCase()).replace(/=/g, '');
                await fetch(HIRISMAN_CONFIG.cloudSyncUrl + cloudKey, {
                    method: 'POST',
                    body: JSON.stringify(allCompanies)
                });
                document.getElementById('cloud-sync-tag').innerText = "Tersinkron Cloud";
            } catch(e) {
                document.getElementById('cloud-sync-tag').innerText = "Tersimpan Lokal";
            }
        }

        async function triggerManualCloudSync() {
            const spin = document.getElementById('sync-spin-icon');
            if (spin) spin.classList.add('animate-spin');
            await loadCompanyDatabaseWithCloudSync();
            setTimeout(() => {
                if (spin) spin.classList.remove('animate-spin');
                alert("Sinkronisasi Cloud Selesai! Data di akun ini telah diselaraskan dengan seluruh perangkat.");
            }, 700);
        }

        function updateUIHead() {
            document.getElementById('sidebar-user-name').innerText = activeAdmin.name;
            document.getElementById('sidebar-user-email').innerText = activeAdmin.email;
            document.getElementById('user-avatar').innerText = activeAdmin.name.slice(0, 2).toUpperCase();
            document.getElementById('topbar-company-name').innerText = activeCompany.name;
            document.getElementById('mobile-company-btn').innerText = activeCompany.code || activeCompany.name;
            document.getElementById('sidebar-company-name').innerText = activeCompany.name;
            document.getElementById('sidebar-company-badge').innerText = (activeCompany.code || 'CO').slice(0, 2);
            document.getElementById('sidebar-company-counter').innerText = `${allCompanies.length}/10 Perusahaan`;
            document.getElementById('dash-greeting').innerText = `Selamat Datang di ${activeCompany.name}!`;
            document.getElementById('dash-comp-tag').innerText = `PERUSAHAAN AKTIF: ${activeCompany.name.toUpperCase()}`;

            updatePrivacyPill();
        }

        function updatePrivacyPill() {
            const pill = document.getElementById('privacy-pill');
            const text = document.getElementById('privacy-pill-text');
            if (activeCompany.isPrivate) {
                pill.className = "px-2.5 py-1 text-[11px] font-bold rounded-lg flex items-center space-x-1 border transition bg-emerald-50 text-emerald-700 border-emerald-200";
                text.innerText = "Privat";
            } else {
                pill.className = "px-2.5 py-1 text-[11px] font-bold rounded-lg flex items-center space-x-1 border transition bg-blue-50 text-blue-700 border-blue-200";
                text.innerText = "Publik";
            }
        }

        function toggleCompanyPrivacy() {
            activeCompany.isPrivate = !activeCompany.isPrivate;
            saveCompanyDatabase();
            updatePrivacyPill();
            alert(`Status privasi data "${activeCompany.name}" diubah menjadi: ${activeCompany.isPrivate ? 'Privat (Hanya Akun Ini)' : 'Publik (Dapat Diakses Tim)'}`);
        }

        function renderActiveCompanyModules() {
            updateUIHead();
            renderEmployees();
            renderAttendance();
            renderPayroll();
            renderSettingsCompanyList();
            updateStats();
            populateAttendanceSelect();
            lucide.createIcons();
        }

        // 2. REAL-TIME RAW INGESTION SCANNER (EXCEL & TXT)
        function toggleRawInputMode(mode) {
            document.getElementById('panel-raw-file').classList.toggle('hidden', mode !== 'file');
            document.getElementById('panel-raw-paste').classList.toggle('hidden', mode === 'file');
            document.getElementById('tab-raw-file').className = mode === 'file' ? 'px-3 py-1.5 rounded-lg bg-white text-emerald-700 shadow-xs' : 'px-3 py-1.5 rounded-lg text-slate-600';
            document.getElementById('tab-raw-paste').className = mode !== 'file' ? 'px-3 py-1.5 rounded-lg bg-white text-emerald-700 shadow-xs' : 'px-3 py-1.5 rounded-lg text-slate-600';
        }

        function handleRawPayrollFileUpload(input) {
            const file = input.files[0];
            if (!file) return;

            document.getElementById('raw-file-label').innerText = `Memindai: ${file.name}...`;
            const ext = file.name.split('.').pop().toLowerCase();

            if (ext === 'txt') {
                const reader = new FileReader();
                reader.onload = e => parseRawTextData(e.target.result);
                reader.readAsText(file);
            } else {
                const reader = new FileReader();
                reader.onload = e => {
                    try {
                        const data = new Uint8Array(e.target.result);
                        const wb = XLSX.read(data, { type: 'array' });
                        const rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
                        processScannedRows(rows);
                    } catch(err) {
                        alert("Gagal membaca berkas Excel.");
                    }
                };
                reader.readAsArrayBuffer(file);
            }
            input.value = '';
        }

        function scanRawPayrollTextRealtime() {
            const text = document.getElementById('raw-payroll-paste').value.trim();
            if (!text) {
                document.getElementById('raw-scan-preview-bar').classList.add('hidden');
                scannedRawEmployees = [];
                return;
            }
            parseRawTextData(text);
        }

        function parseRawTextData(rawText) {
            const lines = rawText.split(/\r?\n/).filter(l => l.trim().length > 0);
            const parsedRows = [];

            lines.forEach((line, idx) => {
                let cols = [];
                if (line.includes('\t')) cols = line.split('\t');
                else if (line.includes(';')) cols = line.split(';');
                else if (line.includes(',')) cols = line.split(',');
                else cols = line.split(/\s{2,}/);

                cols = cols.map(c => c.trim()).filter(c => c.length > 0);

                if (cols.length >= 2) {
                    if (idx === 0 && (cols[0].toLowerCase().includes('nama') || cols[0].toLowerCase().includes('name'))) return;

                    const name = cols[0] || `Pegawai ${idx + 1}`;
                    let salary = 0, allowance = 0, bank = "BCA", acc = "1234567890", nip = `EMP-${Date.now().toString().slice(-4)}`;

                    cols.slice(1).forEach(col => {
                        const cleanedNum = col.replace(/[^0-9]/g, '');
                        if (cleanedNum.length >= 6 && salary === 0) salary = parseInt(cleanedNum);
                        else if (cleanedNum.length >= 5 && allowance === 0 && salary !== 0) allowance = parseInt(cleanedNum);
                        else if (['bca', 'mandiri', 'bni', 'bri', 'cimb', 'bsi'].includes(col.toLowerCase())) bank = col.toUpperCase();
                        else if (col.match(/^[0-9-]{7,16}$/)) acc = col;
                        else if (col.startsWith('EMP') || col.startsWith('NIP')) nip = col;
                    });

                    if (salary === 0) salary = 5000000;
                    parsedRows.push({
                        nip, name, dept: "Operasional", role: "Staff", contract: "Tetap",
                        issue: "Aktif Normal", bank, acc, salary, allowance, isPaid: false
                    });
                }
            });

            processScannedRows(parsedRows);
        }

        function processScannedRows(rows) {
            scannedRawEmployees = [];
            let totalGross = 0;

            rows.forEach((r, idx) => {
                const name = r["Nama Lengkap"] || r["Nama"] || r["Employee Name"] || r.name;
                if (name) {
                    const salary = parseInt(r["Gaji Pokok"] || r["Gaji"] || r["Basic Salary"] || r.salary || 5000000);
                    const allowance = parseInt(r["Tunjangan"] || r["Allowance"] || r.allowance || 0);
                    const bank = r["Bank"] || r["Nama Bank"] || r.bank || "BCA";
                    const acc = r["No Rekening"] || r["Nomor Rekening"] || r["Rekening"] || r.acc || "1234567890";
                    const nip = r["NIP"] || r["ID"] || r.nip || `EMP-${Date.now().toString().slice(-4)}${idx}`;

                    scannedRawEmployees.push({
                        nip, name, dept: r["Divisi"] || r.dept || "Operasional",
                        role: r["Jabatan"] || r.role || "Staff",
                        contract: r["Kontrak"] || r.contract || "Tetap",
                        issue: r["Status Masalah"] || r.issue || "Aktif Normal",
                        bank, acc, salary, allowance, isPaid: false
                    });
                    totalGross += (salary + allowance);
                }
            });

            if (scannedRawEmployees.length > 0) {
                document.getElementById('raw-scan-preview-bar').classList.remove('hidden');
                document.getElementById('scan-detected-title').innerText = `${scannedRawEmployees.length} Staf Ditemukan dari Data Mentah`;
                document.getElementById('scan-detected-desc').innerText = `Total Estimasi Gaji Pokok & Tunjangan: Rp ${totalGross.toLocaleString('id-ID')}`;
            } else {
                document.getElementById('raw-scan-preview-bar').classList.add('hidden');
            }
        }

