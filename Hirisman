                verdict.innerText = "Kualifikasi Belum Optimal (Dipertimbangkan)";
                verdict.className = "text-lg font-bold text-rose-600 mt-0.5";
                setCandidateDecision(false);
            }

            document.getElementById('strengths-list').innerHTML = `
                <li>• Keterampilan kunci cocok: <b>${matched.slice(0, 6).join(', ') || 'Kualifikasi Utama'}</b>.</li>
                <li>• Dokumen terstruktur ramah ATS dan terbaca digital.</li>
                <li>• Latar belakang relevan dengan kebutuhan ${activeCompany.name}.</li>
            `;

            document.getElementById('weaknesses-list').innerHTML = `
                <li>• Kata kunci belum terdeteksi eksplisit: <b>${missing.slice(0, 5).join(', ') || 'Sertifikasi Tambahan'}</b>.</li>
                <li>• Disarankan menguji keterampilan praktis saat sesi wawancara.</li>
            `;

            updateLetterTemplates();
            panel.scrollIntoView({ behavior: 'smooth' });
        }

