            const panel = document.getElementById('screening-result-panel');
            panel.classList.remove('hidden');

            document.getElementById('match-percent').innerText = `${score}%`;
            document.getElementById('circle-progress').setAttribute('stroke-dasharray', `${score}, 100`);
            document.getElementById('metric-skill').innerText = `${score + 2}%`;

            const verdict = document.getElementById('match-verdict');
            if (score >= 70) {
                verdict.innerText = "Kualifikasi Memenuhi Standar (Direkomendasikan LULUS)";
                verdict.className = "text-lg font-bold text-emerald-600 mt-0.5";
                setCandidateDecision(true);
