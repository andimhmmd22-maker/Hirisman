<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>HIRISMAN - Enterprise Multi-Company HRIS & ATS AI</title>
    <!-- Web App Manifest (PWA & APK Auto-Update Ready) -->
    <link rel="manifest" href="data:application/manifest+json;charset=utf-8,%7B%22name%22%3A%22HIRISMAN%20Enterprise%22%2C%22short_name%22%3A%22HIRISMAN%22%2C%22start_url%22%3A%22.%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23ffffff%22%2C%22theme_color%22%3A%22%231e40af%22%7D">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: { 50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a' }
                    }
                }
            }
        }
    </script>
    <!-- Vector Icons (Lucide) -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- PDF.js Engine -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script>
    <!-- Mammoth.js (.DOCX Parser) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <!-- Tesseract.js (OCR Image Parser) -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <!-- SheetJS (Excel .XLSX Engine) -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- jsPDF & AutoTable Engine -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 6px; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col md:flex-row select-none">

    <!-- OVER-THE-AIR (OTA) LIVE UPDATE BANNER -->
    <div id="ota-banner" class="fixed top-3 left-1/2 -translate-x-1/2 z-50 w-11/12 max-w-lg bg-slate-900/95 text-white p-3.5 rounded-2xl shadow-2xl border border-brand-500/40 backdrop-blur-md hidden transition-all">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-xl bg-brand-600 flex items-center justify-center text-white flex-shrink-0 animate-bounce">
                <i data-lucide="sparkles" class="w-5 h-5"></i>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center space-x-2">
                    <span class="text-[10px] font-black uppercase text-brand-400 bg-brand-900 px-1.5 py-0.5 rounded">Update Tersedia</span>
                    <span class="text-xs text-slate-300 font-bold" id="ota-version-tag">v2.5.0</span>
                </div>
                <p class="text-[11px] text-slate-200 truncate mt-0.5">Versi terbaru terdeteksi di website. Klik perbarui untuk menyinkronkan.</p>
            </div>
            <button onclick="applyAppUpdate()" class="px-3.5 py-1.5 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-xs font-bold shadow transition flex-shrink-0">
                Perbarui Sekarang
            </button>
        </div>
    </div>

    <!-- Mobile Header -->
    <header class="md:hidden bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between sticky top-0 z-30 shadow-xs">
        <div class="flex items-center space-x-2">
            <div class="w-9 h-9 bg-brand-600 rounded-xl flex items-center justify-center text-white shadow-md shadow-brand-500/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="2.5"/><path d="M8 15v-1a4 4 0 0 1 8 0v1"/><path d="M4 19h16"/><path d="M9 15h6l1 4H8l1-4z"/></svg>
            </div>
            <span class="font-black text-lg text-slate-900 tracking-tight">HIRIS<span class="text-brand-600">MAN</span></span>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="openCompanyModal()" class="px-2.5 py-1.5 bg-brand-50 text-brand-700 rounded-lg text-xs font-bold border border-brand-200 truncate max-w-[110px]" id="mobile-company-btn">
                Perusahaan
            </button>
            <button onclick="toggleMobileMenu()" class="p-2 text-slate-600 hover:bg-slate-100 rounded-lg">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </div>
    </header>

    <!-- Sidebar Navigation -->
    <aside id="sidebar" class="fixed md:static inset-y-0 left-0 z-40 w-64 bg-white border-r border-slate-200 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-200 shadow-lg md:shadow-none">
        <div>
            <!-- Logo Desktop -->
            <div class="p-5 hidden md:flex items-center space-x-3 border-b border-slate-100">
                <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center text-white shadow-md shadow-brand-500/30 flex-shrink-0">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="2.5"/><path d="M8 15v-1a4 4 0 0 1 8 0v1"/><path d="M4 19h16"/><path d="M9 15h6l1 4H8l1-4z"/></svg>
                </div>
                <div>
                    <h1 class="font-black text-xl text-slate-900 tracking-tight leading-none">HIRIS<span class="text-brand-600">MAN</span></h1>
                    <span class="text-[10px] font-bold text-slate-400 tracking-widest uppercase">Cloud Connected Suite</span>
                </div>
            </div>

            <!-- Selector Perusahaan (Hingga 10 Entitas) -->
            <div class="p-2.5 mx-3 my-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between cursor-pointer hover:border-brand-500 transition" onclick="openCompanyModal()">
                <div class="flex items-center space-x-2.5 overflow-hidden">
                    <div class="w-7 h-7 bg-brand-600 text-white rounded-lg flex items-center justify-center font-black text-xs flex-shrink-0" id="sidebar-company-badge">CO</div>
                    <div class="truncate">
                        <p class="text-xs font-bold text-slate-800 truncate" id="sidebar-company-name">Nama Perusahaan</p>
                        <p class="text-[10px] text-slate-400 font-semibold" id="sidebar-company-counter">1/10 Perusahaan</p>
                    </div>
                </div>
                <i data-lucide="chevrons-up-down" class="w-4 h-4 text-slate-400 flex-shrink-0"></i>
            </div>

            <!-- Navigasi Menu Utama -->
            <nav class="px-3 space-y-1">
                <button onclick="navigate('dashboard')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl font-semibold text-xs text-brand-700 bg-brand-50 transition" data-page="dashboard">
                    <i data-lucide="layout-grid" class="w-4 h-4"></i>
                    <span>Dashboard Utama</span>
                </button>
                <button onclick="navigate('payroll')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl font-semibold text-xs text-slate-600 hover:bg-slate-50 transition" data-page="payroll">
                    <i data-lucide="banknote" class="w-4 h-4"></i>
                    <span>Payroll & Pindai Mentah</span>
                </button>
                <button onclick="navigate('employees')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl font-semibold text-xs text-slate-600 hover:bg-slate-50 transition" data-page="employees">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    <span>Karyawan & Rekam Masalah</span>
                </button>
                <button onclick="navigate('screening')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl font-semibold text-xs text-slate-600 hover:bg-slate-50 transition" data-page="screening">
                    <i data-lucide="file-search" class="w-4 h-4"></i>
                    <span>Skrining CV Multi-Format</span>
                </button>
                <button onclick="navigate('attendance')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl font-semibold text-xs text-slate-600 hover:bg-slate-50 transition" data-page="attendance">
                    <i data-lucide="clock-check" class="w-4 h-4"></i>
                    <span>E-Absensi Digital</span>
                </button>
                <button onclick="navigate('settings')" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl font-semibold text-xs text-slate-600 hover:bg-slate-50 transition" data-page="settings">
                    <i data-lucide="settings-2" class="w-4 h-4"></i>
                    <span>Pengaturan & Cloud Sync</span>
                </button>
            </nav>
        </div>

        <!-- Footer Akun Aktif & Indikator Cloud -->
        <div class="p-3 border-t border-slate-100 bg-slate-50/70">
            <div class="flex items-center justify-between mb-2 cursor-pointer" onclick="openAuthModal()">
                <div class="flex items-center space-x-2.5 overflow-hidden">
                    <div class="w-8 h-8 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-xs shadow flex-shrink-0" id="user-avatar">HR</div>
                    <div class="truncate">
                        <p class="text-xs font-bold text-slate-900 truncate" id="sidebar-user-name">HR Administrator</p>
                        <p class="text-[10px] text-slate-400 truncate" id="sidebar-user-email">admin@hirisman.id</p>
                    </div>
                </div>
                <i data-lucide="arrow-left-right" class="w-4 h-4 text-slate-400 hover:text-brand-600"></i>
            </div>
            <div class="flex items-center justify-between text-[10px] font-semibold px-1">
                <span class="flex items-center space-x-1 text-emerald-600">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="cloud-sync-tag">Cloud Aktif</span>
                </span>
                <span id="app-version-tag" class="font-mono text-brand-600 font-bold">v2.5.0</span>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto custom-scrollbar">
        <!-- Top Navigation Bar -->
        <div class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between sticky top-0 z-20 shadow-xs">
            <div class="flex items-center space-x-2 sm:space-x-3">
                <button onclick="openCompanyModal()" class="flex items-center space-x-1.5 px-3 py-1.5 bg-brand-50 hover:bg-brand-100 text-brand-800 rounded-xl text-xs font-extrabold border border-brand-200 transition">
                    <i data-lucide="building" class="w-4 h-4 text-brand-600"></i>
                    <span id="topbar-company-name" class="truncate max-w-[140px] sm:max-w-xs">Perusahaan Aktif</span>
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                </button>
                <button onclick="toggleCompanyPrivacy()" id="privacy-pill" class="px-2.5 py-1 text-[11px] font-bold rounded-lg flex items-center space-x-1 border transition bg-emerald-50 text-emerald-700 border-emerald-200">
                    <i data-lucide="lock" class="w-3 h-3"></i>
                    <span id="privacy-pill-text">Privat</span>
                </button>
                <button onclick="triggerManualCloudSync()" class="p-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-slate-600 transition" title="Sinkronkan Cloud Sekarang">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5" id="sync-spin-icon"></i>
                </button>
            </div>
            <div class="flex items-center space-x-3">
                <button onclick="toggleLanguage()" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-xl text-xs font-bold text-slate-700 flex items-center space-x-1">
                    <i data-lucide="globe" class="w-3.5 h-3.5 text-brand-600"></i>
                    <span id="lang-tag">ID</span>
                </button>
                <div class="hidden sm:block text-xs font-semibold text-slate-500 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200 font-mono" id="clock-topbar">--:--:-- WIB</div>
            </div>
        </div>

        <div class="p-4 sm:p-6 md:p-8 space-y-6 flex-1" id="main-view">

            <!-- PAGE 1: DASHBOARD UTAMA -->
            <section id="view-dashboard" class="space-y-6">
                <div class="bg-gradient-to-r from-brand-900 via-brand-800 to-brand-700 rounded-2xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden">
                    <div class="relative z-10 max-w-xl">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-200 bg-brand-800/60 px-2 py-0.5 rounded" id="dash-comp-tag">PERUSAHAAN AKTIF</span>
                        <h2 class="text-xl sm:text-3xl font-extrabold mt-3 mb-1.5" id="dash-greeting">Selamat Datang di HIRISMAN</h2>
                        <p class="text-brand-100 text-xs sm:text-sm leading-relaxed">Sistem HRIS & ATS terintegrasi penuh. Semua perubahan data staf, payroll, dan absensi tersinkronisasi otomatis antar-perangkat secara real-time via Akun HIRISMAN Master.</p>
                    </div>
                </div>

                <!-- Quick Menu Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div onclick="navigate('payroll')" class="bg-white p-5 rounded-2xl border border-slate-200 hover:border-emerald-500 hover:shadow-lg cursor-pointer transition group">
                        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3 group-hover:bg-emerald-600 group-hover:text-white transition"><i data-lucide="file-spreadsheet" class="w-5 h-5"></i></div>
                        <h3 class="font-bold text-slate-800 group-hover:text-emerald-600 text-sm">Payroll & Pindai Mentah</h3>
                        <p class="text-xs text-slate-500 mt-1">Pindai berkas mentah Excel/TXT real-time, live scanner, dan simulasi transfer kas.</p>
                    </div>
                    <div onclick="navigate('employees')" class="bg-white p-5 rounded-2xl border border-slate-200 hover:border-brand-500 hover:shadow-lg cursor-pointer transition group">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center mb-3 group-hover:bg-brand-600 group-hover:text-white transition"><i data-lucide="users" class="w-5 h-5"></i></div>
                        <h3 class="font-bold text-slate-800 group-hover:text-brand-600 text-sm">Data Karyawan & Masalah</h3>
                        <p class="text-xs text-slate-500 mt-1">Kelola staf, sinkronisasi antar HP/PC, dan monitor status (Sakit, SP 1-3, PHK).</p>
                    </div>
                    <div onclick="navigate('screening')" class="bg-white p-5 rounded-2xl border border-slate-200 hover:border-indigo-500 hover:shadow-lg cursor-pointer transition group">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3 group-hover:bg-indigo-600 group-hover:text-white transition"><i data-lucide="file-search" class="w-5 h-5"></i></div>
                        <h3 class="font-bold text-slate-800 group-hover:text-indigo-600 text-sm">Skrining CV Multi-Format</h3>
                        <p class="text-xs text-slate-500 mt-1">Dukung PDF, DOCX, TXT, Gambar OCR, dan buat surat resmi otomatis.</p>
                    </div>
                    <div onclick="navigate('attendance')" class="bg-white p-5 rounded-2xl border border-slate-200 hover:border-amber-500 hover:shadow-lg cursor-pointer transition group">
                        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center mb-3 group-hover:bg-amber-600 group-hover:text-white transition"><i data-lucide="clock" class="w-5 h-5"></i></div>
                        <h3 class="font-bold text-slate-800 group-hover:text-amber-600 text-sm">E-Absensi Digital</h3>
                        <p class="text-xs text-slate-500 mt-1">Presensi GPS terverifikasi dengan pencatatan otomatis ke cloud.</p>
                    </div>
                </div>

                <!-- Statistik Data Perusahaan -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                        <span class="text-xs text-slate-500 font-semibold">Staf Aktif Normal</span>
                        <p class="text-2xl font-black text-brand-700 mt-1" id="stat-active-emp">0</p>
                    </div>
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                        <span class="text-xs text-slate-500 font-semibold">Staf Bermasalah / Cuti</span>
                        <p class="text-2xl font-black text-rose-600 mt-1" id="stat-issues-emp">0</p>
                    </div>
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                        <span class="text-xs text-slate-500 font-semibold">Saldo Kas Payroll</span>
                        <p class="text-lg font-black text-emerald-600 mt-1 truncate" id="stat-balance-emp">Rp 0</p>
                    </div>
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                        <span class="text-xs text-slate-500 font-semibold">Kandidat Teruji ATS</span>
                        <p class="text-2xl font-black text-indigo-600 mt-1" id="stat-screened-emp">0</p>
                    </div>
                </div>
            </section>

            <!-- PAGE 2: PAYROLL & PEMINDAI DATA MENTAH REAL-TIME -->
            <section id="view-payroll" class="space-y-6 hidden">
                <div class="bg-gradient-to-r from-slate-900 to-slate-800 p-6 rounded-2xl text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Kas Payroll Perusahaan</span>
                        <div class="flex items-center space-x-3 mt-1">
                            <span class="px-2 py-0.5 bg-brand-600 text-white rounded text-xs font-black" id="comp-bank-name">BCA</span>
                            <span class="text-sm font-mono font-bold" id="comp-bank-acc">8830-1928-3100</span>
                            <span class="text-xs text-slate-300" id="comp-bank-holder">(PT Utama)</span>
                        </div>
                        <p class="text-2xl font-black text-emerald-400 mt-1" id="comp-bank-balance">Rp 250.000.000</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="openEditCompanyBankModal()" class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-xl text-xs font-bold transition">
                            Atur Kas
                        </button>
                        <button onclick="executeBulkPayrollTransfer()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow transition flex items-center space-x-1.5">
                            <i data-lucide="send" class="w-3.5 h-3.5"></i><span>Transfer Gaji Massal</span>
                        </button>
                    </div>
                </div>

                <!-- SMART RAW DATA SCANNER (EXCEL & TXT) -->
                <div class="bg-white p-6 rounded-2xl border-2 border-emerald-200 shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                        <div>
                            <div class="flex items-center space-x-1.5 text-emerald-700 font-extrabold text-xs uppercase tracking-wider mb-0.5">
                                <i data-lucide="sparkles" class="w-4 h-4 text-emerald-600"></i>
                                <span>Real-Time Raw Ingestion Scanner</span>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900">Pemindai Data Mentah Payroll (Excel & TXT)</h3>
                            <p class="text-xs text-slate-500">Unggah berkas mentah (.xlsx, .csv, .txt) atau tempel data teks. Sistem otomatis memindai dan memetakan kolom gaji ke cloud secara real-time.</p>
                        </div>
                        <div class="flex bg-slate-100 p-0.5 rounded-xl text-xs font-bold">
                            <button onclick="toggleRawInputMode('file')" id="tab-raw-file" class="px-3 py-1.5 rounded-lg bg-white text-emerald-700 shadow-xs">Unggah Berkas</button>
                            <button onclick="toggleRawInputMode('paste')" id="tab-raw-paste" class="px-3 py-1.5 rounded-lg text-slate-600">Tempel Teks Mentah</button>
                        </div>
                    </div>

                    <div id="panel-raw-file" class="border-2 border-dashed border-emerald-300 rounded-2xl p-6 text-center bg-emerald-50/30 hover:bg-emerald-50/60 transition">
                        <input type="file" id="raw-file-input" accept=".xlsx, .xls, .csv, .txt" class="hidden" onchange="handleRawPayrollFileUpload(this)">
                        <label for="raw-file-input" class="cursor-pointer inline-flex items-center space-x-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow transition">
                            <i data-lucide="upload" class="w-4 h-4"></i>
                            <span>Pilih Berkas Mentah (Excel .xlsx/.csv atau Teks .txt)</span>
                        </label>
                        <p id="raw-file-label" class="text-xs text-slate-500 mt-2 font-medium">Format fleksibel: Mendukung kolom Nama, Gaji Pokok, Tunjangan, Bank, Rekening, NIP</p>
                    </div>

                    <div id="panel-raw-paste" class="space-y-2 hidden">
                        <textarea id="raw-payroll-paste" rows="5" oninput="scanRawPayrollTextRealtime()" placeholder="Salin baris data dari Excel atau TXT lalu tempel di sini...&#10;Contoh:&#10;Hendra Gunawan    12000000    1500000    BCA    5310291823    EMP-001&#10;Siti Aminah       10500000    1000000    Mandiri 1420019283    EMP-002" class="w-full p-3.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-mono leading-relaxed focus:bg-white focus:border-emerald-500 focus:outline-none custom-scrollbar"></textarea>
                        <p class="text-[11px] text-slate-400 font-medium">Sistem otomatis mendeteksi pemisah Tab, Koma, Titik Koma, atau Spasi saat Anda menempel data.</p>
                    </div>

                    <div id="raw-scan-preview-bar" class="p-3.5 bg-emerald-50 rounded-xl border border-emerald-200 hidden flex flex-col sm:flex-row items-center justify-between gap-3">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-xs flex-shrink-0">
                                <i data-lucide="check" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <h4 class="text-xs font-bold text-emerald-900" id="scan-detected-title">0 Data Staf Terdeteksi</h4>
                                <p class="text-[11px] text-emerald-700" id="scan-detected-desc">Total Beban Gaji Mentah: Rp 0</p>
                            </div>
