            const net = (emp.salary + (emp.allowance || 0)) - ((emp.salary * 0.04) + (emp.salary * 0.05));

            if (emp.isPaid) {
                alert(`BUKTI TRANSFER PENGGAJIAN (RESMI)\n-----------------------------------\nPerusahaan: ${activeCompany.name}\nDari Kas: ${activeCompany.bank.name} - ${activeCompany.bank.accNumber}\nPenerima: ${emp.name} (${emp.bank} - ${emp.acc})\nNominal: Rp ${net.toLocaleString('id-ID')}\nStatus: BERHASIL`);
                return;
            }
            if ((activeCompany.bank.balance || 0) < net) {
                alert("Saldo kas tidak cukup. Silakan top-up saldo kas perusahaan.");
                return;
            }

            if (confirm(`Kirim gaji Rp ${net.toLocaleString('id-ID')} ke ${emp.name}?`)) {
                activeCompany.bank.balance -= net;
                emp.isPaid = true;
                saveCompanyDatabase();
                renderPayroll();
                updateStats();
            }
        }

        function executeBulkPayrollTransfer() {
            const unpaid = (activeCompany.employees || []).filter(e => !e.isPaid);
            if (unpaid.length === 0) {
                alert("Seluruh gaji sudah lunas.");
                return;
            }

            const total = unpaid.reduce((sum, e) => sum + ((e.salary + (e.allowance || 0)) - ((e.salary * 0.04) + (e.salary * 0.05))), 0);
            if ((activeCompany.bank.balance || 0) < total) {
                alert(`Saldo kas tidak mencukupi untuk transfer massal. Butuh: Rp ${total.toLocaleString('id-ID')}.`);
                return;
            }

            if (confirm(`Transfer massal untuk ${unpaid.length} staf dengan total Rp ${total.toLocaleString('id-ID')}?`)) {
                activeCompany.bank.balance -= total;
                unpaid.forEach(e => e.isPaid = true);
                saveCompanyDatabase();
                renderPayroll();
                updateStats();
                alert("Transfer massal berhasil diproses dan disimpan ke cloud!");
            }
        }

        function openEditCompanyBankModal() {
            document.getElementById('modal-bank').classList.remove('hidden');
            const bank = activeCompany.bank || {};
            document.getElementById('bank-c-name').value = bank.name || "BCA";
            document.getElementById('bank-c-acc').value = bank.accNumber || "";
            document.getElementById('bank-c-holder').value = bank.holder || activeCompany.name;
            document.getElementById('bank-c-balance').value = bank.balance || 0;
        }
        function closeEditCompanyBankModal() { document.getElementById('modal-bank').classList.add('hidden'); }

        function saveCompanyBankDetails(e) {
            e.preventDefault();
            activeCompany.bank = {
                name: document.getElementById('bank-c-name').value.trim(),
                accNumber: document.getElementById('bank-c-acc').value.trim(),
                holder: document.getElementById('bank-c-holder').value.trim(),
                balance: parseInt(document.getElementById('bank-c-balance').value) || 0
            };
            saveCompanyDatabase();
            renderPayroll();
            updateStats();
            closeEditCompanyBankModal();
        }

        function exportPayrollExcel() {
            if (!activeCompany.employees || activeCompany.employees.length === 0) return alert("Belum ada data.");
            const data = activeCompany.employees.map(e => ({
                "Nama": e.name, "Bank": e.bank, "Rekening": e.acc, "Gaji Pokok": e.salary,
                "Take Home Pay": (e.salary + (e.allowance || 0)) - ((e.salary * 0.04) + (e.salary * 0.05)),
                "Status": e.isPaid ? "LUNAS" : "BELUM"
            }));
            const ws = XLSX.utils.json_to_sheet(data);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Payroll");
            XLSX.writeFile(wb, `Payroll_${activeCompany.code}.xlsx`);
        }

        // 7. E-ABSENSI DIGITAL
        function populateAttendanceSelect() {
            const sel = document.getElementById('attend-emp-select');
            if (!sel) return;
            if (!activeCompany.employees || activeCompany.employees.length === 0) {
                sel.innerHTML = '<option value="">Belum ada staf</option>';
                return;
            }
            sel.innerHTML = activeCompany.employees.map(e => `<option value="${e.name}">${e.name} (${e.role})</option>`).join('');
        }

        function recordAttendance(type) {
            if (!activeCompany.employees || activeCompany.employees.length === 0) return alert("Tambahkan staf terlebih dahulu.");
            const name = document.getElementById('attend-emp-select').value;
            if (!name) return;

            const timeStr = new Date().toLocaleTimeString('id-ID') + " WIB";
            activeCompany.attendance.unshift({ name, type, time: timeStr, status: "Tervalidasi (Geofence GPS)" });
            saveCompanyDatabase();
            renderAttendance();
            alert(`Presensi ${type} untuk ${name} berhasil dicatat.`);
        }

        function renderAttendance() {
            const tbody = document.getElementById('attend-table-body');
            const emptyBox = document.getElementById('attend-empty-box');
            const logs = activeCompany.attendance || [];

            if (logs.length === 0) {
                tbody.innerHTML = '';
                emptyBox.classList.remove('hidden');
                return;
            }
            emptyBox.classList.add('hidden');
            tbody.innerHTML = logs.slice(0, 10).map(l => `
            <tr class="hover:bg-slate-50 transition">
                <td class="py-2.5 px-4 font-bold text-slate-800">${l.name}</td>
                <td class="py-2.5 px-4"><span class="px-2 py-0.5 text-[10px] font-bold rounded-full ${l.type === 'Masuk' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-brand-800'}">${l.type}</span></td>
                <td class="py-2.5 px-4 text-slate-600">${l.time}</td>
                <td class="py-2.5 px-4 text-emerald-600 font-semibold flex items-center space-x-1"><i data-lucide="shield-check" class="w-3.5 h-3.5"></i><span>${l.status}</span></td>
            </tr>`).join('');
            lucide.createIcons();
        }

        function clearAttendanceLogs() {
            if (confirm("Bersihkan seluruh log presensi hari ini?")) {
                activeCompany.attendance = [];
                saveCompanyDatabase();
                renderAttendance();
            }
        }

        // 8. MULTI-COMPANY MODAL CONTROLLER
        function openCompanyModal() {
            document.getElementById('modal-company').classList.remove('hidden');
            const list = document.getElementById('company-pick-list');
            list.innerHTML = allCompanies.map((c, i) => `
            <div onclick="switchActiveCompany('${c.id}')" class="p-2.5 rounded-xl border ${c.id === activeCompany.id ? 'border-brand-600 bg-brand-50' : 'border-slate-200 hover:bg-slate-50'} cursor-pointer flex items-center justify-between transition">
                <div class="flex items-center space-x-2.5 overflow-hidden">
                    <div class="w-7 h-7 rounded-lg ${c.id === activeCompany.id ? 'bg-brand-600 text-white' : 'bg-slate-200 text-slate-700'} font-black text-xs flex items-center justify-center flex-shrink-0">${(c.code || 'CO').slice(0, 2)}</div>
                    <div class="truncate">
                        <p class="text-xs font-bold text-slate-800 truncate">${c.name}</p>
                        <p class="text-[10px] text-slate-400">${(c.employees || []).length} Staf • ${c.isPrivate ? 'Privat' : 'Publik'}</p>
                    </div>
                </div>
                ${c.id === activeCompany.id ? '<span class="text-[11px] font-bold text-brand-600">Aktif</span>' : ''}
            </div>`).join('');
        }
        function closeCompanyModal() { document.getElementById('modal-company').classList.add('hidden'); }

        function switchActiveCompany(id) {
            const found = allCompanies.find(c => c.id === id);
            if (found) {
                activeCompany = found;
                saveCompanyDatabase();
                renderActiveCompanyModules();
                closeCompanyModal();
            }
        }

        function openAddCompanyModal() {
            if (allCompanies.length >= 10) return alert("Batas maksimal 10 perusahaan telah tercapai.");
            closeCompanyModal();
            document.getElementById('modal-add-comp').classList.remove('hidden');
        }
        function closeAddCompanyModal() { document.getElementById('modal-add-comp').classList.add('hidden'); }

        function saveNewCompany(e) {
            e.preventDefault();
            const newComp = {
                id: 'comp_' + Date.now(),
                name: document.getElementById('new-c-name').value.trim(),
                code: document.getElementById('new-c-code').value.trim().toUpperCase(),
                isPrivate: true,
                bank: {
                    name: document.getElementById('new-c-bank').value.trim(),
                    accNumber: document.getElementById('new-c-acc').value.trim(),
                    holder: document.getElementById('new-c-name').value.trim(),
                    balance: parseInt(document.getElementById('new-c-balance').value) || 0
                },
                employees: [],
                attendance: [],
                screenCount: 0
            };
            allCompanies.push(newComp);
            activeCompany = newComp;
            saveCompanyDatabase();
            renderActiveCompanyModules();
            closeAddCompanyModal();
            e.target.reset();
        }

        function renderSettingsCompanyList() {
            const container = document.getElementById('settings-comp-list');
            if (!container) return;
            container.innerHTML = allCompanies.map((c, i) => `
            <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between">
                <div>
                    <span class="font-bold text-xs text-slate-800">${i + 1}. ${c.name} (${c.code})</span>
                    <span class="block text-[10px] text-slate-400">Saldo: Rp ${(c.bank.balance || 0).toLocaleString('id-ID')} • ${c.isPrivate ? 'Privat' : 'Publik'}</span>
                </div>
                <button onclick="switchActiveCompany('${c.id}')" class="px-2.5 py-1 text-xs font-bold rounded-lg ${c.id === activeCompany.id ? 'bg-emerald-600 text-white' : 'bg-white border border-slate-300 text-slate-700'}">
                    ${c.id === activeCompany.id ? 'Aktif' : 'Pilih'}
                </button>
            </div>`).join('');
        }

        // 9. AUTENTIKASI: GOOGLE ONE-TAP & MULTI-AKUN
        function openAuthModal() {
            document.getElementById('modal-auth').classList.remove('hidden');
            const users = JSON.parse(localStorage.getItem('hirisman_users') || '[]');
            document.getElementById('saved-users-list').innerHTML = users.map(u => `
            <div onclick="selectUserAccount('${u.email}')" class="p-2 rounded-xl border ${u.email === activeAdmin.email ? 'border-brand-500 bg-brand-50' : 'border-slate-200 hover:bg-slate-50'} cursor-pointer flex items-center justify-between transition">
                <div class="flex items-center space-x-2">
                    <div class="w-6 h-6 rounded-full bg-brand-600 text-white font-bold text-[10px] flex items-center justify-center">${u.name.slice(0, 1).toUpperCase()}</div>
                    <div><p class="text-xs font-bold text-slate-800">${u.name}</p><p class="text-[9px] text-slate-400">${u.email}</p></div>
                </div>
                <i data-lucide="log-in" class="w-3.5 h-3.5 text-slate-400"></i>
            </div>`).join('');
            lucide.createIcons();
        }
        function closeAuthModal() { document.getElementById('modal-auth').classList.add('hidden'); }

        function selectUserAccount(email) {
            const users = JSON.parse(localStorage.getItem('hirisman_users') || '[]');
            const u = users.find(x => x.email.toLowerCase() === email.toLowerCase());
            if (u) {
                if (u.isGoogle) return switchAccountSession(u);
                const pwd = prompt(`Masukkan kata sandi untuk ${u.email}:`);
                if (pwd === u.pwd) switchAccountSession(u);
                else if (pwd !== null) alert("Kata sandi salah.");
            }
        }

        function handleGoogleOneTap() {
            const email = prompt("Simulasi Google One-Tap Login:\nMasukkan email Google Anda:", "admin.holding@gmail.com");
            if (!email) return;

            let users = JSON.parse(localStorage.getItem('hirisman_users') || '[]');
            let u = users.find(x => x.email.toLowerCase() === email.toLowerCase());
            if (!u) {
                u = { name: email.split('@')[0].toUpperCase(), email, pwd: "", isGoogle: true };
                users.push(u);
                localStorage.setItem('hirisman_users', JSON.stringify(users));
            }
            switchAccountSession(u);
        }

        async function switchAccountSession(u) {
            activeAdmin = { name: u.name, email: u.email };
            localStorage.setItem('hirisman_active_session', JSON.stringify(activeAdmin));
            closeAuthModal();
            await loadCompanyDatabaseWithCloudSync();
            alert(`Sesi aktif beralih ke: ${u.name} (${u.email}). Data cloud telah dimuat.`);
        }

        function handleNewAccountRegister(e) {
            e.preventDefault();
            const name = document.getElementById('acc-name').value.trim();
            const email = document.getElementById('acc-email').value.trim();
            const pwd = document.getElementById('acc-pwd').value.trim();

            let users = JSON.parse(localStorage.getItem('hirisman_users') || '[]');
            if (users.some(x => x.email.toLowerCase() === email.toLowerCase())) return alert("Email sudah terdaftar.");

            const u = { name, email, pwd, isGoogle: false };
            users.push(u);
            localStorage.setItem('hirisman_users', JSON.stringify(users));
            switchAccountSession(u);
            e.target.reset();
        }

        // 10. OTA UPDATE ENGINE & MASTER BACKUP
        function checkAppUpdates(isManual) {
            const localVer = localStorage.getItem('hirisman_local_ver') || HIRISMAN_CONFIG.version;
            const remoteVer = localStorage.getItem('hirisman_remote_ver') || HIRISMAN_CONFIG.version;

            if (remoteVer > localVer) {
                document.getElementById('ota-banner').classList.remove('hidden');
                document.getElementById('ota-version-tag').innerText = `v${remoteVer}`;
            } else if (isManual) {
                alert(`Aplikasi dan Website telah sinkron pada versi terbaru (v${HIRISMAN_CONFIG.version}).`);
            }
        }

        function simulateNewRelease() {
            localStorage.setItem('hirisman_remote_ver', "2.5.0");
            checkAppUpdates(false);
            alert("Simulasi rilis versi v2.5.0 dikirim dari Website! Periksa banner notifikasi update di bagian atas.");
        }

        function applyAppUpdate() {
            localStorage.setItem('hirisman_local_ver', localStorage.getItem('hirisman_remote_ver') || "2.5.0");
            alert("Menyinkronkan dan memuat fitur terbaru dari website...");
            location.reload();
        }

        function downloadMasterExcelBackup() {
            const wb = XLSX.utils.book_new();
            const empData = (activeCompany.employees || []).map(e => ({
                "NIP": e.nip, "Nama": e.name, "Divisi": e.dept, "Jabatan": e.role, "Masalah": e.issue, "Gaji Pokok": e.salary
            }));
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(empData), "Karyawan");

            const attData = (activeCompany.attendance || []).map(a => ({
                "Nama": a.name, "Tipe": a.type, "Waktu": a.time, "Status": a.status
            }));
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(attData), "Presensi");

            XLSX.writeFile(wb, `Backup_Master_${activeCompany.code}.xlsx`);
        }

        function downloadMasterPdfAudit() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            doc.setFont("helvetica", "bold");
            doc.setFontSize(13);
            doc.setTextColor(30, 64, 175);
            doc.text(`LAPORAN AUDIT RESMI - ${activeCompany.name.toUpperCase()}`, 14, 16);

            doc.setFontSize(8);
            doc.setFont("helvetica", "normal");
            doc.setTextColor(100, 100, 100);
            doc.text(`Admin: ${activeAdmin.name} (${activeAdmin.email}) | Tanggal: ${new Date().toLocaleString('id-ID')}`, 14, 22);

            const table = (activeCompany.employees || []).map(e => [e.nip, e.name, e.dept, e.role, e.issue, `Rp ${Number(e.salary).toLocaleString('id-ID')}`]);
            doc.autoTable({
                startY: 26,
                head: [['NIP', 'Nama Pegawai', 'Divisi', 'Jabatan', 'Kondisi Masalah', 'Gaji Pokok']],
                body: table.length > 0 ? table : [['-', 'Belum ada data', '-', '-', '-', '-']],
                theme: 'grid',
                headStyles: { fillColor: [30, 64, 175], textColor: [255, 255, 255] },
                styles: { fontSize: 8 }
            });
            doc.save(`Audit_${activeCompany.code}.pdf`);
        }

        function sendBackupToAdminEmail() {
            const sub = `[BACKUP DATA] ${activeCompany.name}`;
            const body = `Arsip Data Perusahaan:\nPerusahaan: ${activeCompany.name}\nAdmin: ${activeAdmin.name}\nJumlah Staf: ${(activeCompany.employees || []).length}\nKas: Rp ${(activeCompany.bank.balance || 0).toLocaleString('id-ID')}`;
            window.location.href = `mailto:${encodeURIComponent(activeAdmin.email)}?subject=${encodeURIComponent(sub)}&body=${encodeURIComponent(body)}`;
        }

        // 11. NAVIGATION & HELPERS
        function updateStats() {
            const list = activeCompany.employees || [];
            document.getElementById('stat-active-emp').innerText = list.filter(e => e.issue === 'Aktif Normal').length;
            document.getElementById('stat-issues-emp').innerText = list.filter(e => e.issue !== 'Aktif Normal').length;
            document.getElementById('stat-balance-emp').innerText = `Rp ${Number(activeCompany.bank ? activeCompany.bank.balance : 0).toLocaleString('id-ID')}`;
            document.getElementById('stat-screened-emp').innerText = activeCompany.screenCount || 0;
        }

        function navigate(page) {
            ['dashboard', 'screening', 'employees', 'attendance', 'payroll', 'settings'].forEach(p => {
                document.getElementById(`view-${p}`).classList.add('hidden');
            });
            document.getElementById(`view-${page}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-brand-700', 'bg-brand-50');
                btn.classList.add('text-slate-600');
                if (btn.dataset.page === page) {
                    btn.classList.add('text-brand-700', 'bg-brand-50');
                    btn.classList.remove('text-slate-600');
                }
            });

            const sidebar = document.getElementById('sidebar');
            if (sidebar && !sidebar.classList.contains('-translate-x-full') && window.innerWidth < 768) {
                sidebar.classList.add('-translate-x-full');
            }
            lucide.createIcons();
        }

        function toggleMobileMenu() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
        }

        function startLiveClock() {
            setInterval(() => {
                const now = new Date();
                const str = now.toLocaleTimeString('id-ID') + " WIB";
                const c1 = document.getElementById('clock-topbar');
                const c2 = document.getElementById('clock-attend');
                if (c1) c1.innerText = str;
                if (c2) c2.innerText = str;
            }, 1000);
        }

        function toggleLanguage() {
            currentLang = currentLang === 'id' ? 'en' : 'id';
            document.getElementById('lang-tag').innerText = currentLang.toUpperCase();
            alert(`Bahasa diatur ke: ${currentLang === 'id' ? 'Bahasa Indonesia' : 'English'}`);
        }
    </script>
</body>
